1. Invoice Distribution by Country 
-- =====================================================
-- BUSINESS QUESTION:
-- Which countries have the highest number of invoices?
--
-- SKILLS:
-- COUNT, GROUP BY, ORDER BY, Aggregation
-- =====================================================
SELECT
BillingCountry AS "Country",
COUNT(InvoiceId) AS "Total"
FROM invoices
GROUP BY BillingCountry
ORDER BY COUNT(InvoiceId) DESC;

 

2. Average Track Price by Genre
-- =====================================================
-- BUSINESS QUESTION:
-- Which music genres have the highest average track price?
--
-- SKILLS:
-- JOIN, AVG, ROUND, GROUP BY, ORDER BY
-- =====================================================

SELECT
g.Name AS “Genre”,
ROUND(AVG(t.UnitPrice),2) AS "Average Price"
FROM genres g
JOIN tracks t
	ON g.GenreId = t.GenreId
GROUP BY g.GenreId, g.Name
ORDER BY AVG(t.UnitPrice) DESC;

 
3. Revenue by Sales Support Agent 
-- =====================================================
-- BUSINESS QUESTION:
-- How much total revenue is associated with each
-- Sales Support Agent?
--
-- SKILLS:
-- JOIN, SUM, ROUND, GROUP BY, ORDER BY
-- =====================================================

SELECT
e.FirstName||' '||e.LastName AS "Sales Support Agent",
ROUND(SUM(i.Total),2) AS "Total"
FROM employees e
JOIN customers c
 ON e.EmployeeId = c.SupportRepId
JOIN invoices i
	ON c.CustomerId = i.CustomerId
WHERE e.Title = 'Sales Support Agent'
GROUP BY e.FirstName||' '||e.LastName
ORDER BY ROUND(SUM(i.Total),2) DESC;
 
4. Tracks per Playlist
-- =====================================================
-- BUSINESS QUESTION:
-- How many tracks are included in each playlist?
--
-- SKILLS:
-- JOIN, COUNT, GROUP BY
-- =====================================================
SELECT
p.Name AS "Playlist",
COUNT(pt.TrackId) AS "Quantity"
FROM playlists p
JOIN playlist_track pt
	ON p.PlaylistId = pt.PlaylistId
GROUP BY p.PlaylistId;


 
5. Annual Sales Comparison — Exercise 11
-- =====================================================
-- BUSINESS QUESTION:
-- How many invoices were generated, and what was the
-- total revenue in 2009 and 2013?
--
-- SKILLS:
-- strftime, COUNT, SUM, GROUP BY, Date Filtering
-- =====================================================
SELECT
strftime('%Y', InvoiceDate) AS “Year”,
COUNT(InvoiceId) AS "Invoices",
SUM(Total) AS "Total"
FROM invoices
WHERE strftime('%Y', InvoiceDate IN ('2009','2013')
GROUP BY strftime('%Y', InvoiceDate);

 
6. Invoices Above Average Value
-- =====================================================
-- BUSINESS QUESTION:
-- Which invoices have a total value above the average
-- invoice amount?
--
-- SKILLS:
-- Subqueries, AVG, WHERE, Aggregate Comparison
-- =====================================================

SELECT
InvoiceId AS "ID",
Total
FROM invoices
WHERE Total > (SELECT
               AVG(Total)
              	FROM invoices);
 
7. Total Spending by Customer
-- =====================================================
-- BUSINESS QUESTION:
-- Which customers have the highest total spending?
--
-- SKILLS:
-- JOIN, SUM, GROUP BY, ORDER BY
-- =====================================================
SELECT
c.CustomerId AS ID,
c.FirstName||' '||c.LastName AS "Customer",
SUM(i.Total) AS "Total Spent"
FROM customers c
JOIN invoices i
	ON c.CustomerId = i.CustomerId
GROUP BY c.CustomerId
ORDER BY SUM(i.Total) DESC;

 
8. Average Tracks Purchased per Customer
-- =====================================================
-- BUSINESS QUESTION:
-- How many tracks does each purchasing customer buy
-- on average?
--
-- SKILLS:
-- CTEs (WITH), COUNT DISTINCT, SUM, Aggregation,
-- Mathematical Operations
-- =====================================================

WITH customers_with_purchase AS (
  SELECT
  COUNT(DISTINCT i.CustomerId) AS customers_total
  FROM invoices i
),

purchased_tracks AS (
  SELECT
  SUM(it.Quantity) AS total_tracks
  FROM invoice_items it)

SELECT
ROUND(total_tracks / customers_total,0) AS "Average Tracks per Customer"
FROM customers_with_purchase, purchased_tracks;
 
9. Monthly Revenue Analysis — Exercise 17
-- =====================================================
-- BUSINESS QUESTION:
-- How did monthly revenue evolve throughout 2009?
--
-- SKILLS:
-- SUM, ROUND, strftime, GROUP BY, ORDER BY,
-- Date Filtering, Time-Based Analysis
-- =====================================================
SELECT
strftime('%m',InvoiceDate) AS “Month”,
ROUND(SUM(Total),2) AS "Total"
FROM invoices
WHERE InvoiceDate >= '2009-01-01'
AND InvoiceDate < '2010-01-01'
GROUP BY strftime('%m',InvoiceDate)
ORDER BY strftime('%m',InvoiceDate) ASC;
